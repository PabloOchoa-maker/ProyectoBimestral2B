@startuml streamflow_uml
title Sistema StreamFlow — Diagrama de Clases (MVC + SOLID)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 60
skinparam class {
    BorderColor #2C3E50
    ArrowColor #2C3E50
    FontName Segoe UI
}
skinparam packageStyle rectangle
skinparam classFontStyle bold
hide empty members

package modelo #E8F5E9 {

    class Usuario {
        -id: String
        -nombre: String
        -email: String
        -favoritos: List<Contenido>
        +agregarFavorito(c: Contenido): void
    }

    class Suscripcion {
        -id: String
        -fechaInicio: LocalDate
        -costoMensual: double
    }

    package contrato #E3F2FD {
        interface Detallable {
            +obtenerDetalles(): String
        }
        interface Reproducible {
            +reproducir(): void
        }
    }

    abstract class Contenido {
        #id: String
        #titulo: String
        #genero: Genero
        #calidad: Calidad
        #duracionMin: int
        #costoBase: double
        +calcularCosto(): double
        +{abstract} reproducir(): void
        +{abstract} obtenerDetalles(): String
    }

    class Pelicula {
        -director: String
        +reproducir(): void
        +obtenerDetalles(): String
    }

    class Serie {
        -temporadas: int
        -episodios: int
        +reproducir(): void
        +obtenerDetalles(): String
    }

    class Documental {
        -tema: String
        +reproducir(): void
        +obtenerDetalles(): String
    }

    class Podcast <<OCP: nuevo tipo>> {
        -presentador: String
        +reproducir(): void
        +obtenerDetalles(): String
    }

    enum Calidad {
        SD
        HD
        UHD_4K
        -factor: double
        +getFactor(): double
    }

    enum Genero {
        ACCION
        COMEDIA
        DRAMA
        TERROR
        DOCUMENTAL
    }

    Contenido ..|> Detallable
    Contenido ..|> Reproducible

    Pelicula --|> Contenido
    Serie --|> Contenido
    Documental --|> Contenido
    Podcast --|> Contenido

    Contenido --> Calidad
    Contenido --> Genero

    Usuario "1" o--> "0..*" Contenido : favoritos
    Usuario "1" *--> "1" Suscripcion
}

package vista #E1F5FE {

    interface IVista {
        +mostrarMenu(): void
        +mostrarContenidos(lista: List<Contenido>): void
        +iniciar(): void
    }

    class ConsolaVista {
        -contenidoControlador: IContenidoControlador
        -usuarioControlador: IUsuarioControlador
        +mostrarMenu(): void
        +mostrarContenidos(lista: List<Contenido>): void
        +mostrarMensaje(mensaje: String): void
        +iniciar(): void
    }

    ConsolaVista .up.|> IVista
}

package controlador #FFFDE7 {

    interface IContenidoControlador {
        +registrar(c: Contenido): boolean
        +listar(): List<Contenido>
    }

    interface IUsuarioControlador {
        +registrar(u: Usuario): boolean
        +facturar(idUsuario: String): double
        +recomendar(idUsuario: String): List<Contenido>
        +agregarFavorito(idUsuario: String, c: Contenido): boolean
    }

    class ContenidoControlador {
        -contenidoService: IContenidoService
        +registrar(c: Contenido): boolean
        +listar(): List<Contenido>
    }

    class UsuarioControlador {
        -usuarioService: IUsuarioService
        -suscripcionService: ISuscripcionService
        -recomendacionService: IRecomendacionService
        +registrar(u: Usuario): boolean
        +facturar(idUsuario: String): double
        +recomendar(idUsuario: String): List<Contenido>
        +agregarFavorito(idUsuario: String, c: Contenido): boolean
    }

    ContenidoControlador .up.|> IContenidoControlador
    UsuarioControlador .up.|> IUsuarioControlador
}

package servicio #EDE7F6 {

    interface IContenidoService {
        +registrar(c: Contenido): boolean
        +listar(): List<Contenido>
    }

    interface IUsuarioService {
        +registrar(u: Usuario): boolean
        +buscarPorId(id: String): Usuario
        +agregarFavorito(idUsuario: String, c: Contenido): boolean
    }

    interface ISuscripcionService {
        +calcularCostoMensual(u: Usuario): double
    }

    interface IRecomendacionService {
        +recomendarPorGenero(u: Usuario): List<Contenido>
    }

    class ContenidoServiceImpl {
        -contenidoDao: IContenidoDao
        +registrar(c: Contenido): boolean
        +listar(): List<Contenido>
    }

    class UsuarioServiceImpl {
        -usuarioDao: IUsuarioDao
        +registrar(u: Usuario): boolean
        +buscarPorId(id: String): Usuario
        +agregarFavorito(idUsuario: String, c: Contenido): boolean
    }

    class SuscripcionServiceImpl {
        -contenidoDao: IContenidoDao
        +calcularCostoMensual(u: Usuario): double
    }

    class RecomendacionServiceImpl {
        -contenidoDao: IContenidoDao
        +recomendarPorGenero(u: Usuario): List<Contenido>
    }

    ContenidoServiceImpl .up.|> IContenidoService
    UsuarioServiceImpl .up.|> IUsuarioService
    SuscripcionServiceImpl .up.|> ISuscripcionService
    RecomendacionServiceImpl .up.|> IRecomendacionService
}

package persistencia #FBE9E7 {

    interface IContenidoDao {
        +insertar(c: Contenido): boolean
        +listar(): List<Contenido>
        +buscarPorId(id: String): Contenido
        +actualizar(c: Contenido): boolean
        +eliminar(id: String): boolean
    }

    interface IUsuarioDao {
        +insertar(u: Usuario): boolean
        +listar(): List<Usuario>
        +buscarPorId(id: String): Usuario
        +actualizar(u: Usuario): boolean
        +eliminar(id: String): boolean
        +agregarFavorito(idUsuario: String, c: Contenido): boolean
    }

    class ContenidoDaoSQLite {
        +insertar(c: Contenido): boolean
        +listar(): List<Contenido>
        +buscarPorId(id: String): Contenido
        +actualizar(c: Contenido): boolean
        +eliminar(id: String): boolean
    }

    class UsuarioDaoSQLite {
        -contenidoDao: IContenidoDao
        +insertar(u: Usuario): boolean
        +listar(): List<Usuario>
        +buscarPorId(id: String): Usuario
        +actualizar(u: Usuario): boolean
        +eliminar(id: String): boolean
        +agregarFavorito(idUsuario: String, c: Contenido): boolean
        -cargarFavoritos(u: Usuario): void
    }

    class ContenidoDaoMemoria <<test>> {
        -datos: List<Contenido>
        +insertar(c: Contenido): boolean
        +listar(): List<Contenido>
        +buscarPorId(id: String): Contenido
        +actualizar(c: Contenido): boolean
        +eliminar(id: String): boolean
    }

    class UsuarioDaoMemoria <<test>> {
        -datos: List<Usuario>
        +insertar(u: Usuario): boolean
        +listar(): List<Usuario>
        +buscarPorId(id: String): Usuario
        +actualizar(u: Usuario): boolean
        +eliminar(id: String): boolean
        +agregarFavorito(idUsuario: String, c: Contenido): boolean
    }

    class ConexionBD {
        -URL: String
        +obtenerConexion(): Connection
    }

    ContenidoDaoSQLite .up.|> IContenidoDao
    UsuarioDaoSQLite .up.|> IUsuarioDao
    ContenidoDaoMemoria .up.|> IContenidoDao
    UsuarioDaoMemoria .up.|> IUsuarioDao

    ContenidoDaoSQLite ..> ConexionBD
    UsuarioDaoSQLite ..> ConexionBD

    ' Necesita el DAO de contenidos para reconstruir los favoritos que lee
    ' de la tabla puente.
    UsuarioDaoSQLite --> IContenidoDao

    note bottom of UsuarioDaoSQLite
        Los favoritos se guardan en la tabla
        puente usuario_favorito(usuario_id,
        contenido_id), con PK compuesta y
        borrado en cascada.
    end note
}

' --- Flujo entre capas: cada capa solo habla con la de abajo ---
' Los controladores entran por el constructor de la vista concreta, no por el
' contrato IVista: la dependencia vive en ConsolaVista.
ConsolaVista --> IContenidoControlador
ConsolaVista --> IUsuarioControlador

ContenidoControlador --> IContenidoService
UsuarioControlador --> IUsuarioService
UsuarioControlador --> ISuscripcionService
UsuarioControlador --> IRecomendacionService

ContenidoServiceImpl --> IContenidoDao
UsuarioServiceImpl --> IUsuarioDao
SuscripcionServiceImpl --> IContenidoDao
RecomendacionServiceImpl --> IContenidoDao


' --- Columna vertical forzada: cada implementacion queda debajo de su interfaz,
'     y la siguiente capa debajo de la implementacion anterior ---
ConsolaVista -[hidden]-> IContenidoControlador
ContenidoControlador -[hidden]-> IContenidoService
ContenidoServiceImpl -[hidden]-> IContenidoDao

' --- Empuja la columna vista/controlador/servicio/persistencia a la derecha
'     del paquete modelo ---
Usuario -[hidden]right-> IVista
Contenido -[hidden]right-> IContenidoControlador

legend right
  <b>Leyenda</b>
  --|>  herencia (extends)
  ..|>  implementa interfaz
  -->   asociación / dependencia con atributo
  ..>   dependencia de uso
  o-->  agregación    *-->  composición
endlegend

@enduml
